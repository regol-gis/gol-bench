+        let trace = std::env::var_os("GOL_BENCH_HANDOFF_TRACE").is_some();
+        let fetch_faults = std::sync::atomic::AtomicI64::new(0);
+        let handed = AtomicUsize::new(0);
+        let next = AtomicUsize::new(0);
+        let (send, ready) = mpsc::sync_channel(0);
+        let exec_start = trace.then(thread_faults);
+        let result = pool.in_place_scope(|scope| {
+            for _ in 0..self.width.min(tiles.len()) {
+                let send = send.clone();
+                let (next, handed, fetch_faults) = (&next, &handed, &fetch_faults);
+                scope.spawn(move |_| {
+                    let start = trace.then(thread_faults);
+                    let mut sent = 0;
+                    let mut cursor = template.worker_cursor();
+                    while !budget.cancelled.load(Ordering::Relaxed) {
+                        let Some(tile) = tiles.get(next.fetch_add(1, Ordering::Relaxed)) else {
