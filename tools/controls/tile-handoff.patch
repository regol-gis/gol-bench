+                            Ok(Some(tile)) => {
+                                sent += 1;
+                                if send.send(Ok(tile)).is_err() {
+                                    break;
+                                }
+                            }
+                            Ok(None) => (),
+                            Err(e) => {
+                                let _ = send.send(Err(e));
+                                break;
+                            }
+                        }
+                    }
