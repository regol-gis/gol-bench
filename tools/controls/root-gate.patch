+/// Each completed tile votes on using the ordinary root-span hints for
+/// subsequent tiles. Updating the eight-bit history costs one atomic operation
+/// per stalled tile and does not require query-specific estimates or result IDs.
+#[cfg(feature = "parallel")]
+#[derive(Default)]
+pub(super) struct GateSample {
+    last: Option<u64>,
+    pages: u32,
+    forward: u32,
+    sampling: bool,
+    groups: u32,
+    dense: u32,
+    admitted: u32,
+}
+#[cfg(feature = "parallel")]
+impl GateSample {
+    pub(super) fn visit(&mut self, address: u64) {
+        let page = address / GOL_PAGE as u64;
+        if self.last == Some(page) { return; }
+        if self.last.replace(page).is_some_and(|previous| previous + 1 == page) {
+            self.forward = self.forward.saturating_add(1);
+        }
+        self.pages = self.pages.saturating_add(1);
+    }
+}
+#[cfg(feature = "parallel")]
+impl Drop for GateSample {
+    fn drop(&mut self) {
+        if std::env::var_os("GOL_BENCH_GATE_TRACE").is_some() {
+            eprintln!("ROOT_GATE {} {} {}", self.groups, self.dense, self.admitted);
+        }
+    }
+}
