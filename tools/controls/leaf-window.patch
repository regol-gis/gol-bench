+//! Experimental admission of small, forward hints after a mapped worker stalls.
+use crate::source::MappedFile;
+use std::time::Instant;
+
+const PAGE: u64 = 4096;
+const PILOT: u64 = 4;
+const MAX_WINDOW: u64 = 16;
+const TILE_LIMIT: u64 = 64;
+
+pub(super) struct LeafWindow {
+    tile: u64,
+    last: Option<u64>,
+    run: u64,
+    started: Instant,
+    baseline_ns: u128,
+    width: u64,
+    until: u64,
+    issued: u64,
+    trace: bool,
+    observed: u64,
+    adjacent: u64,
+    requests: u64,
+    requested_pages: u64,
+    used_pages: u64,
+}
+
+impl LeafWindow {
+    pub(super) fn new() -> Self {
+        Self {
+            tile: u64::MAX,
+            last: None,
+            run: 0,
+            started: Instant::now(),
+            baseline_ns: 0,
+            width: 0,
+            until: 0,
+            issued: 0,
+            trace: std::env::var_os("GOL_BENCH_WINDOW_TRACE").is_some(),
+            observed: 0,
+            adjacent: 0,
+            requests: 0,
+            requested_pages: 0,
+            used_pages: 0,
+        }
+    }
+
+    pub(super) fn visit(&mut self, source: &MappedFile, tile: u64, end: u64, p: u64) {
+        if p < tile || p >= end {
+            return;
+        }
+        let page = p / PAGE;
+        if self.tile != tile {
+            self.tile = tile;
+            self.last = None;
+            self.issued = 0;
+        }
+        if self.last == Some(page) {
+            return;
+        }
+        let adjacent = self
+            .last
+            .replace(page)
+            .is_some_and(|previous| previous + 1 == page);
+        if self.trace {
+            self.observed += 1;
+            self.adjacent += u64::from(adjacent);
+        }
+        if !adjacent {
+            self.run = 0;
+            self.width = 0;
+            return;
+        }
+        if self.issued >= TILE_LIMIT && self.width == 0 {
+            return;
+        }
+        if self.width != 0 {
+            if self.trace {
+                self.used_pages += 1;
+            }
+            if page < self.until {
+                return;
+            }
+            // Compare per-page progress in the trial window with the preceding
+            // unhinted run. A slower trial returns to a fresh demand pilot.
+            let ns = self.started.elapsed().as_nanos() / u128::from(self.width);
+            if ns >= self.baseline_ns {
+                self.width = 0;
+                self.run = 0;
+                return;
+            }
+            self.width = (self.width * 2).min(MAX_WINDOW);
+        } else {
+            if self.run == 0 {
+                self.started = Instant::now();
+            }
+            self.run += 1;
+            if self.run <= PILOT {
+                return;
+            }
+            self.baseline_ns = self.started.elapsed().as_nanos() / u128::from(PILOT);
+            self.width = PILOT;
+        }
+        let start = (page + 1) * PAGE;
+        let length =
+            (self.width.min(TILE_LIMIT - self.issued) * PAGE).min(end.saturating_sub(start));
+        if length == 0 || !source.hint_leaf_range(start, length) {
+            self.run = 0;
+            self.width = 0;
+            return;
+        }
+        self.width = length.div_ceil(PAGE);
+        self.until = page + self.width;
+        self.issued += self.width;
+        self.started = Instant::now();
+        if self.trace {
+            self.requests += 1;
+            self.requested_pages += self.width;
+        }
+    }
+}
+
+impl Drop for LeafWindow {
+    fn drop(&mut self) {
+        if self.trace {
+            eprintln!(
+                "LEAF_WINDOW {} {} {} {} {}",
+                self.observed, self.adjacent, self.requests, self.requested_pages, self.used_pages
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::source::mapped_scan_test_support::mapped_fixture;
+
+    #[test]
+    fn hints_stay_in_tile_and_stop_at_a_gap_or_byte_limit() -> crate::Result<()> {
+        let bytes = vec![0; (PAGE * 400) as usize];
+        let source = mapped_fixture(&bytes)?;
+        let mut window = LeafWindow::new();
+        for page in 0..6 {
+            window.visit(&source, 0, PAGE * 7, page * PAGE);
+        }
+        assert_eq!((window.width, window.until, window.issued), (1, 6, 1));
+        window.visit(&source, 0, PAGE * 7, PAGE * 3);
+        assert_eq!(window.width, 0);
+        for page in 10..400 {
+            window.visit(&source, PAGE * 10, PAGE * 400, page * PAGE);
+            assert!(window.issued <= TILE_LIMIT && window.width <= MAX_WINDOW);
+        }
+        assert_eq!(window.issued, TILE_LIMIT);
+        Ok(())
+    }
+}
